{
  "network": {
    "host": "0.0.0.0",
    "port": 5000
  },
  "strategy": "fedavg",
  "rounds": 15,
  "expected_clients": 4,
  "expected_client_ids": ["c1", "c2", "c3", "c4"],
  "min_clients": 1,
  "start_timeout_s": 300,
  "round_timeout_s": 90,
  "training": {
    "local_epochs": 1,
    "kd_epochs": 2,
    "temperature": 2.0,
    "batch_size": 64,
    "lr": 0.001,
    "optimizer": "adam"
  },
  "model": {
    "architecture": "cnn",
    "distill_epochs": 2,
    "distill_lr": 0.001
  },
  "dp": {
    "enabled": false,
    "clip_norm": 1.0,
    "noise_sigma": 4.0,
    "target_delta": 1e-05
  },
  "encryption": {
    "enabled": true,
    "key_file": "secret.key"
  },
  "paths": {
    "public_file": "data/processed/public.npz",
    "test_file": "data/processed/test.npz",
    "out_root": "runs"
  }
}
